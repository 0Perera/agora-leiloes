# Postgres do docker-compose.yml. No Render: Internal Database URL.
DATABASE_URL=postgres://agora:agora@localhost:5432/agora
# true só para a External Database URL do Render (acesso da máquina local).
DB_SSL=false
# Loga as queries (sem parâmetros), para conferir N+1 em desenvolvimento. Em produção: false.
DB_LOG_QUERIES=true
# Origem do front liberada no CORS.
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Segredo do JWT, com 32 caracteres ou mais. Gere com: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Segredo da cadeia de lances, do selo, do alias e do comprovante, com 32 caracteres ou mais.
# Nunca muda depois do seed: trocar invalida todas as assinaturas gravadas.
BID_HMAC_SECRET=dev-only-bid-hmac-secret-change-me-0123
# API pública do Cleveland Museum of Art, usada só pelo módulo catalog.
CLEVELAND_API_URL=https://openaccess-api.clevelandart.org/api
